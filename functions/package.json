{
  "name": "functions",
  "type": "module",
  "scripts": {
    "build": "npx esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/server.js --packages=external",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "dist/server.js",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.2",
    "postgres": "^3.4.7",
    "@supabase/supabase-js": "^2.49.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "firebase-functions-test": "^3.4.1"
  },
  "private": true
}