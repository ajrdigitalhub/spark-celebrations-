{
  "name": "spark-celebrations",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node -e \"const fs = require('fs'); const path = 'dist/spark-celebrations/browser/index.csr.html'; if (fs.existsSync(path)) fs.renameSync(path, 'dist/spark-celebrations/browser/index.html');\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:spark-celebrations": "node dist/spark-celebrations/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/animations": "^22.0.8",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.8",
    "@supabase/supabase-js": "^2.110.8",
    "@types/file-saver": "^2.0.7",
    "@types/jszip": "^3.4.0",
    "@types/three": "^0.185.4",
    "browser-image-compression": "^2.0.2",
    "express": "^5.1.0",
    "file-saver": "^2.0.5",
    "gsap": "^3.15.0",
    "jszip": "^3.10.1",
    "lenis": "^1.3.25",
    "ngx-image-cropper": "^9.1.6",
    "rxjs": "~7.8.0",
    "swiper": "^14.0.6",
    "three": "^0.185.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2"
  }
}
